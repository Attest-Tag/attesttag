#!/bin/sh
# Refuses a push that would publish something this repository must not hold. It is public: what
# leaves here is readable by anyone at once, and stays in the history after it is taken out.
#
# Checked, over the commits the push adds that no remote has yet:
#   - files: dotenv files, keys and certificates, databases, credential JSON, and anything
#     .gitignore says is not part of the repository but was committed anyway;
#   - added lines: the shapes of real credentials (fake test fixtures are shaped differently);
#   - both: every string in .git/info/public-denylist, one per line — the identifiers of your
#     own deployment (cloud project, service URL, database instance, workspace ids). It lives
#     under .git/ so the list of what must stay private is never itself committed.
#
# Enable once per clone with `make hooks`. `git push --no-verify` skips it; don't.

z40=0000000000000000000000000000000000000000
deny="$(git rev-parse --git-dir)/info/public-denylist"
fail=0

say() { printf 'pre-push: %s\n' "$*" >&2; fail=1; }

secrets='AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|xox[abposr]-[0-9]+-[0-9]+-[A-Za-z0-9]+|sk-or-v1-[0-9a-f]{64}|sk-ant-[A-Za-z0-9_-]{80,}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9]{22}_[A-Za-z0-9]{59}|sk_live_[A-Za-z0-9]{20,}|whsec_[A-Za-z0-9]{24,}|AIza[0-9A-Za-z_-]{35}|re_[A-Za-z0-9]{8}_[A-Za-z0-9]{20,}|"private_key_id": *"[0-9a-f]{40}"'

while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$z40" ] && continue # deleting a branch publishes nothing
	commits=$(git rev-list "$local_sha" --not --remotes)
	[ -z "$commits" ] && continue

	# Files in the tree being pushed.
	files=$(git ls-tree -r --name-only "$local_sha")
	bad=$(printf '%s\n' "$files" | grep -E '(^|/)\.env($|\.)|\.(pem|key|p12|pfx|db|db-wal|db-shm|sqlite)$|credentials.*\.json$|service-account.*\.json$' | grep -vE '(^|/)\.env\.example$|/env/[^/]+\.env\.example$')
	[ -n "$bad" ] && say "files that hold secrets or data would be published:" && printf '  %s\n' $bad >&2
	ignored=$(printf '%s\n' "$files" | git check-ignore --no-index --stdin)
	[ -n "$ignored" ] && say ".gitignore excludes these, but they are committed (git rm --cached them):" && printf '  %s\n' $ignored >&2

	# Lines the new commits add.
	added=$(for c in $commits; do git show --format= --no-color -U0 "$c"; done | grep -E '^\+' | grep -vE '^\+\+\+ ')
	# Only the start of each match: a hook that prints the whole key has leaked it to a terminal.
	hits=$(printf '%s\n' "$added" | grep -oE "$secrets" | cut -c1-8 | sed 's/$/…/')
	[ -n "$hits" ] && say "added lines look like real credentials:" && printf '%s\n' "$hits" | sed 's/^/  /' >&2

	if [ -s "$deny" ]; then
		while IFS= read -r term; do
			case "$term" in '' | '#'*) continue ;; esac
			if printf '%s\n' "$added" | grep -qiF -- "$term" || printf '%s\n' "$files" | grep -qiF -- "$term"; then
				say "a deployment-private identifier from $deny would be published (the term is not repeated here)"
			fi
		done <"$deny"
	else
		printf 'pre-push: note: no %s — add your deployment'"'"'s identifiers there, one per line\n' "$deny" >&2
	fi
done

[ "$fail" = 0 ] || { printf 'pre-push: refused. Fix the above, rewrite the commits that added it, and push again.\n' >&2; exit 1; }
exit 0
