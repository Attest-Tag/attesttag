{
  "display_information": { "name": "attest_tag", "description": "AI teammate on open-weight models" },
  "features": {
    "bot_user": { "display_name": "attest_tag", "always_online": true },
    "assistant_view": {
      "assistant_description": "Ask me about this workspace, our docs, or the web. @mention me in any channel.",
      "suggested_prompts": [
        { "title": "Summarize a channel", "message": "Summarize what happened in #general this week." },
        { "title": "Search our docs", "message": "How do we handle customer refunds?" }
      ]
    },
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    }
  },
  "oauth_config": {
    "redirect_urls": [
      "${BASE_URL}/slack/oauth/callback",
      "${BASE_URL}/api/auth/callback"
    ],
    "scopes": { "bot": [
      "app_mentions:read", "assistant:write", "chat:write", "chat:write.customize",
      "channels:history", "groups:history", "im:history", "mpim:history",
      "channels:read", "groups:read", "im:read", "im:write",
      "users:read", "users:read.email",
      "pins:read", "files:read", "files:write", "reactions:write",
      "search:read.public"
    ] }
  },
  "settings": {
    "event_subscriptions": { "request_url": "${BASE_URL}/slack/events", "bot_events": [
      "app_mention", "message.channels", "message.groups", "message.im", "message.mpim",
      "assistant_thread_started", "assistant_thread_context_changed", "app_home_opened",
      "app_uninstalled", "tokens_revoked"
    ] },
    "interactivity": { "is_enabled": true, "request_url": "${BASE_URL}/slack/interactions" },
    "socket_mode_enabled": false
  }
}
