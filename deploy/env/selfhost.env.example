# attest_tag — the settings a self-hosted deployment needs.
#
# Copy to `.env` next to docker-compose.yml, or let deploy/local/bootstrap.sh do it and
# generate the secrets for you. guide/configuration.md is the full reference and `.env.example`
# in the repository root the long commented list; this is the short list, in the order you will
# need it.
#
# Anything the console can override lives in the console. These are the things it cannot:
# credentials, and decisions about the deployment itself.

# ── 1. Required. The service will not start, or will start and do nothing, without these. ──

# api.slack.com/apps → Basic Information → App Credentials.
# `BASE_URL=https://your-host ./deploy/slack/manifest.sh` prints the app definition to paste.
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Any OpenAI-compatible endpoint. The defaults point at OpenRouter; a local vLLM or Ollama
# works by setting LLM_BASE_URL and putting any non-empty string here.
OPENROUTER_API_KEY=

# Seals every stored credential with AES-256-GCM: Slack bot tokens, connection secrets,
# per-user OAuth tokens, TOTP secrets. The container refuses to start without it.
#
#   openssl rand -base64 32      (base64 of 32 bytes; a hex key is refused)
#
# BACK THIS UP somewhere other than the machine it runs on. Lose it and every connection has
# to be reconnected by hand — there is no recovery, by design.
MASTER_KEY=

# ── 2. Required behind a reverse proxy, which is all of them. ──

# The public https origin people reach the console on, no trailing slash.
#
# Without it the bot learns its origin from the first authenticated request's Host header and
# keeps it — and that origin is what password-reset, verification and invitation links are
# built from, for everybody. Set it when you know the URL, and again whenever the URL changes
# (a quick tunnel's changes on every restart). PUBLIC_ORIGIN_HOSTS is the other way: the exact
# hosts, comma separated, the origin may be learned from, rather than first-writer-wins.
ADMIN_BASE_URL=
#PUBLIC_ORIGIN_HOSTS=

# Whether X-Forwarded-For names the caller, for the sign-in lockouts, the signup and reset limits
# and the address in the audit log. Unset, it is believed from a private or loopback peer — the
# tunnel and Caddy in this compose project reach the bot that way — and ignored from a public one.
# 1 if your proxy reaches the container from a public address; 0 if nothing sits in front of it
# on a private network.
#TRUST_PROXY=

# For the compose profiles that give you that https origin (deploy/docs/https.md). `tunnel`
# needs the token of a named Cloudflare tunnel; `caddy` needs the domain pointed at this machine,
# and takes an optional contact address for the certificate authority.
#CLOUDFLARE_TUNNEL_TOKEN=
#ATTEST_DOMAIN=bot.example.com
#ATTEST_ACME_EMAIL=you@example.com

# ── 2b. The database. SQLite unless you say otherwise. ──

# Leave DATABASE_URL empty and the deployment runs on SQLite at DB_PATH — one container, one
# volume, nothing to operate. Set it and the deployment runs on Postgres, which is what more
# than one instance needs, and what the platforms with no local disk need.
#
# SQLite requires a LOCAL BLOCK DEVICE and exactly one writer. Not NFS, not SMB — so not EFS
# and not Azure Files. On a network filesystem it corrupts quietly and is noticed later.
#DATABASE_URL=postgres://user:pass@host:5432/attesttag?sslmode=require

# Documents. A volume by default; an S3-compatible bucket if you name one, which is what a
# platform with no persistent disk or no FUSE mount needs. Covers S3, R2, MinIO, Spaces, B2.
# Naming one also streams the SQLite database into it and restores it on boot, so a container
# that loses its disk does not lose the deployment.
#DOCS_S3_URL=s3://my-bucket/docs?endpoint=https://acct.r2.cloudflarestorage.com&region=auto
#DOCS_S3_KEY_ID=
#DOCS_S3_SECRET=

# Or run them in this compose project instead of signing up for anything — a Postgres, a MinIO,
# or both. Two profiles and two extra compose files (see docker-compose.yml), and these are the
# credentials they use. bootstrap.sh generates the two passwords; both services listen on
# loopback only.
#
# Left empty here on purpose, and compose refuses to start either service while they are: this
# file is a template, and a password in a template is a password everybody has.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=attesttag
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=attesttag

# Compose reads these for itself, so that `docker compose up -d` is the whole command rather
# than four flags every time. Uncomment the pair that matches what you turned on above.
#COMPOSE_FILE=docker-compose.yml:deploy/local/postgres.yml:deploy/local/minio.yml
#COMPOSE_PROFILES=postgres,minio,quicktunnel

# ── 3. Strongly recommended. ──

# Who the bot answers, by email domain. Each organisation keeps its own list under Settings →
# Security, seeded from its founder's domain (unless that is a public mail provider's); this is
# only the default for an organisation that keeps none — set here, every such organisation
# answers only these domains. Guests and members from another workspace (Slack Connect, or
# another Microsoft 365 tenant) are refused either way unless allow_external_users is turned on
# for the org.
#ALLOWED_EMAIL_DOMAINS=example.com

# Who may create a console account. first-run (the default) means you sign up once and
# everybody else arrives by invitation. Set `open` only to run a service for strangers.
#SIGNUP_MODE=first-run

# Whether an organisation may use its own model key (Settings → Models) instead of the one above:
# all (the default), enterprise, or off. Handy on a deployment of your own for rotating the key
# without a redeploy.
#ORG_MODEL_KEYS=all

# Per-organisation ceilings, sized for a service with open signup. On a small deployment they
# are in the way — two thousand documents is a number somebody hits. The full list is in the
# repository root .env.example; the two most likely to bite are here.
#LIMIT_DOCUMENTS_PER_ORG=2000
#LIMIT_SIGNUPS_PER_IP_PER_HOUR=5

# ── 4. Optional, and it degrades honestly without them. ──

# Email. With no key the mailer only logs, the console treats mail as off and shows a link to
# copy instead of promising an inbox nobody will read — so you can sign up, verify and invite
# people with no mail provider at all. The domain must be verified at resend.com/domains.
#RESEND_API_KEY=
#MAIL_FROM=attest_tag <no-reply@mail.example.com>

# Microsoft Teams, beside Slack. Register an Azure Bot whose messaging endpoint is
# https://<your host>/msteams/messages and turn on its Microsoft Teams channel; the console then
# generates the app package each tenant installs. guide/msteams.md has the steps. The app id and
# password together, and the tenant id unless the Azure Bot is MultiTenant (MSTEAMS_APP_TYPE may
# stay unset for SingleTenant): half of them is a startup error rather than a bot that cannot
# answer.
#MSTEAMS_APP_ID=
#MSTEAMS_APP_PASSWORD=
#MSTEAMS_TENANT_ID=
#MSTEAMS_APP_TYPE=SingleTenant
# Sign in with Microsoft to the console, through the same app registration: "organizations", or
# your own tenant id to let in nobody else's. Register <your host>/api/auth/microsoft/callback on
# the app registration as a Web redirect URI first.
#MSTEAMS_SIGNIN=

# Models. Defaults are in the repository root .env.example.
#LLM_BASE_URL=https://openrouter.ai/api/v1
#LLM_MODEL=
#HEAVY_MODEL=
#EMBED_MODEL=

# The time zone for an organisation that has none; a new organisation takes its founder's zone
# anyway.
#TZ_NAME=America/New_York
#LOG_LEVEL=info

# ── 5. Deliberately left off. ──
#
# These exist for a hosted service handing strangers a key somebody else pays for. On a
# deployment spending its own key each is wrong, and each defaults to off:
#
#   FREE_PLAN_BUDGET_USD               0  — no free-plan cap; use MONTHLY_BUDGET_USD instead
#   PLATFORM_MONTHLY_BUDGET_USD_PER_ORG   unset — no operator ceiling
#   SUPPORT_EMAIL                     empty — budget refusals name nobody, and the console's
#                                             Upgrade and Help buttons, which send mail, are
#                                             not offered
#   OPERATOR_SECRET                   empty — /api/operator/ and the /operator pages do not
#                                             exist
#   SITE_URL                          empty — the console fetches from its own origin and
#                                             nothing else
#
# WORKER_MODE is off, so "fix this and raise a PR" is not offered. `workers` turns it on: each
# job runs in a container of its own, and the bot works out where from the environment its
# platform gives it. It logs which one at boot.
#
#   WORKER_MODE=workers
#
# Naming the platform pins it instead — the escape hatch when detection would be wrong:
#
#   cloudrun   a Cloud Run Job execution      deploy/gcp/worker.sh
#   ecs        a Fargate task                 deploy/aws/worker.sh
#   aca        an Azure Container Apps job    deploy/azure/worker.sh
#   k8s        a batch/v1 Job                 helm --set worker.enabled=true
#   docker     a container on this host       docker compose -f … -f deploy/local/worker.yml
#   local      this binary as a subprocess    development only
#
# Each of those scripts prints the WORKER_* settings to paste back here. Read
# deploy/docs/platforms.md#the-fix-job-worker before turning any of them on, because a worker
# runs the code of whatever repository it is pointed at — and because `docker` means giving the
# bot the Docker socket, which is root on the host.
#WORKER_MODE=off
#
# `docker` also needs the id of the group that owns the socket, which deploy/local/worker.yml
# adds the bot to and refuses to start without. This prints it:
#   docker run --rm -v /var/run/docker.sock:/var/run/docker.sock alpine stat -c %g /var/run/docker.sock
#ATTEST_DOCKER_GID=
#
# Set this and every job gets its own OpenRouter key with its own ceiling, destroyed when the job
# ends. Without it every job spends OPENROUTER_API_KEY with no per-job cap, inside a container
# running somebody else's repository — and with SIGNUP_MODE=open a job is refused instead.
# openrouter.ai/settings/provisioning-keys
#OPENROUTER_PROVISIONING_KEY=
